{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mastercraft-leather-atelier",
  "main": "cart-worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL" }
  ]
}
